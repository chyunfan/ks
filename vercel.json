{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/credit-exam-cloud",
      "destination": "/ks",
      "permanent": false
    },
    {
      "source": "/credit-exam-cloud/:path*",
      "destination": "/ks/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ks/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/ks",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/ks/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/ks/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "functions": {
    "api/register.js": { "memory": 256, "maxDuration": 10 },
    "api/login.js": { "memory": 256, "maxDuration": 10 },
    "api/health.js": { "memory": 128, "maxDuration": 5 }
  }
}
